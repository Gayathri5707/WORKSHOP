#include <stdio.h>

int load(int x, int y)
{
    int sum = 0;

    for (int i = x + 1; i <= y; i++)
    {
        sum += i;
    }

    return sum;
}

int main()
{
    int result = 0;
    int count = 3;

    result = load(0, count);

    printf("Sum of number from 1 to %d is %d\n", count, result);

    return 0;
}
